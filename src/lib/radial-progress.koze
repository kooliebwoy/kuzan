<script>
  import { props } from 'koze:component';
  const {
    value = 0,
    max = 100,
    label = '',
    size = 'md',
    class: className = '',
  } = props;
  const normalized = Math.max(0, Math.min(Number(value) / Number(max || 100), 1));
  const percentage = Math.round(normalized * 100);
</script>

<div
  class={`kui-radial-progress kui-radial-progress--${size} ${className}`.trim()}
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax={max}
  aria-valuenow={value}
  style={`--kui-radial-value: ${percentage}%`}
>
  <span>{label || `${percentage}%`}</span>
</div>
