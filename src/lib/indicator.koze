<script>
  import { props } from 'koze:component';
  const {
    label = '',
    position = 'top-end',
    variant = 'primary',
    class: className = '',
  } = props;
</script>

<span class={`kui-indicator ${className}`.trim()}>
  <slot></slot>
  if (label) {
    <span class="kui-indicator__mark" data-position={position} data-variant={variant}>{label}</span>
  } else {
    <span class="kui-indicator__dot" data-position={position} data-variant={variant} aria-hidden="true"></span>
  }
</span>
